name: "Soharab"
designer: "Sohrab Zia"
license: "OFL"
category: "HANDWRITING"
date_added: "2026-11-21"
fonts {
  name: "Soharab"
  style: "normal"
  weight: 400
  filename: "Soharab[slnt,wght].ttf"
  post_script_name: "Soharab-Regular"
  full_name: "Soharab Regular"
  copyright: "Copyright 2026 The Soharab Project Authors (https://github.com/sohrabzia/Soharab-Typeface)"
}
subsets: "latin"
subsets: "menu"
axes {
  tag: "slnt"
  min_value: -12.0
  max_value: 0.0
  default_value: 0.0
}
axes {
  tag: "wght"
  min_value: 100.0
  max_value: 900.0
  default_value: 400.0
}
source {
  repository_url: "https://github.com/sohrabzia/Soharab-Typeface"
  commit: "main"
  files {
    source_file: "OFL.txt"
    dest_file: "OFL.txt"
  }
  files {
    source_file: "fonts/variable/Soharab[slnt,wght].ttf"
    dest_file: "Soharab[slnt,wght].ttf"
  }
  files {
    source_file: "DESCRIPTION.en_us.html"
    dest_file: "DESCRIPTION.en_us.html"
  }
}
